        <mxCell id="merge" value="Destino de merge aprovado&#xa;definido pelo projeto" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#718096;fontColor=#263746;fontSize=15;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1210" y="390" width="280" height="95" as="geometry" /></mxCell>
