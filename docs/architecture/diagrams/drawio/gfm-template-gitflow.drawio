        <mxCell id="title" value="Versionamento e CI/CD | Planejamento para projetos futuros" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#123B5D;" vertex="1" parent="1"><mxGeometry x="50" y="35" width="1450" height="50" as="geometry" /></mxCell>
        <mxCell id="note" value="Este template não define nomes oficiais de branches, regras de merge nem um modelo GitFlow. Essas decisões devem ser definidas e aprovadas na governança de cada projeto." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF4E5;strokeColor=#D97706;fontColor=#713B0C;fontSize=16;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="1300" height="85" as="geometry" /></mxCell>
        <mxCell id="policy" value="Política de branches / merge&#xa;específica do projeto" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1F4F7;strokeColor=#718096;fontColor=#263746;fontSize=15;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="change" value="Alteração proposta&#xa;dentro do escopo aprovado" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2F8;strokeColor=#2F80ED;fontColor=#123B5D;fontSize=15;arcSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="220" height="95" as="geometry" /></mxCell>
