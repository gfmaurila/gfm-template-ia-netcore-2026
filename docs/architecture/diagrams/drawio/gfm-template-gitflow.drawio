        <mxCell id="deploy" value="Implantação controlada&#xa;e reversão planejadas" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCEEF2;strokeColor=#138A9E;fontColor=#123B5D;fontSize=15;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1050" y="640" width="250" height="95" as="geometry" /></mxCell>
